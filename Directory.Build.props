<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- App version, shown in the file properties of Journal.exe and in the app (FR-UI-02). 1.1.0: ISS-010, 011, 013-016. 1.2.0: ISS-017 to ISS-025. 1.3.0: ISS-012, ISS-028, ISS-029. -->
    <Version>1.3.0</Version>
    <WindowsTfm>net10.0-windows10.0.19041.0</WindowsTfm>
    <SupportedOSPlatformVersion Condition="'$(UseWindowsTfm)' == 'true'">10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
</Project>
