<UserControl x:Class="Journal.App.Controls.MonthCalendarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" AutomationProperties.Name="Calendar">
    <UserControl.InputBindings>
        <KeyBinding Key="Left" Command="{Binding MoveSelectionCommand}" CommandParameter="{x:Static local:CalendarKeys.Back1}" xmlns:local="clr-namespace:Journal.App.Controls" />
        <KeyBinding Key="Right" Command="{Binding MoveSelectionCommand}" CommandParameter="{x:Static local:CalendarKeys.Forward1}" xmlns:local="clr-namespace:Journal.App.Controls" />
        <KeyBinding Key="Up" Command="{Binding MoveSelectionCommand}" CommandParameter="{x:Static local:CalendarKeys.Back7}" xmlns:local="clr-namespace:Journal.App.Controls" />
        <KeyBinding Key="Down" Command="{Binding MoveSelectionCommand}" CommandParameter="{x:Static local:CalendarKeys.Forward7}" xmlns:local="clr-namespace:Journal.App.Controls" />
        <KeyBinding Key="Enter" Command="{Binding OpenSelectedCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PreviousMonthCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextMonthCommand}" />
    </UserControl.InputBindings>
    <Border x:Name="Frame" Style="{StaticResource Card}" Padding="12,10,12,8">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="Previous month (Page Up)"
                        AutomationProperties.Name="Previous month" Command="{Binding PreviousMonthCommand}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Next month (Page Down)"
                        AutomationProperties.Name="Next month" Command="{Binding NextMonthCommand}" />
                <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}" FontSize="17" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding WeekdayNames}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkMuted}" Margin="0,0,0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource DayButton}"
                                Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,6,0,0">
                <Button Style="{StaticResource LinkButton}" Content="Today" Command="{Binding TodayCommand}" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentSoft}" VerticalAlignment="Center" />
                    <TextBlock Text="entry" FontSize="11" Foreground="{StaticResource InkMuted}" Margin="4,0,10,0" />
                    <Ellipse Width="5" Height="5" Fill="{StaticResource Today}" VerticalAlignment="Center" />
                    <TextBlock Text="open items" FontSize="11" Foreground="{StaticResource InkMuted}" Margin="4,0,0,0" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
