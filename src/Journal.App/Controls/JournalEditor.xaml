<UserControl x:Class="Journal.App.Controls.JournalEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="{StaticResource Line}" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- Formatting toolbar -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,5">
            <WrapPanel x:Name="Toolbar" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="FontBox" Width="150" Height="26" Margin="0,0,4,0" IsTextSearchEnabled="True"
                          ToolTip="Font" AutomationProperties.Name="Font" SelectionChanged="FontBox_SelectionChanged" />
                <ComboBox x:Name="SizeBox" Width="58" Height="26" IsEditable="True" ToolTip="Font size (points)"
                          AutomationProperties.Name="Font size" LostKeyboardFocus="SizeBox_Commit" KeyDown="SizeBox_KeyDown"
                          SelectionChanged="SizeBox_SelectionChanged" />
                <Border Style="{StaticResource Sep}" />
                <ToggleButton x:Name="ColorButton" Style="{StaticResource ToolToggle}" ToolTip="Text color" AutomationProperties.Name="Text color">
                    <StackPanel>
                        <TextBlock Text="A" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                        <Border x:Name="ColorSwatch" Height="3" Width="16" Background="{StaticResource Ink}" />
                    </StackPanel>
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=ColorButton}" PlacementTarget="{Binding ElementName=ColorButton}"
                       StaysOpen="False" Closed="Popup_Closed" Tag="{Binding ElementName=ColorButton}">
                    <Border Style="{StaticResource Card}" Padding="10">
                        <StackPanel Width="188">
                            <TextBlock Text="Text color" Style="{StaticResource Label}" />
                            <WrapPanel x:Name="TextSwatches" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="Apply" Padding="8,3" Click="CustomTextColor_Click" />
                                <TextBox x:Name="TextHex" Margin="0,0,6,0" Text="#1E2430" AutomationProperties.Name="Custom text color" />
                            </DockPanel>
                            <Button Content="Default color" Margin="0,8,0,0" Click="DefaultTextColor_Click" />
                        </StackPanel>
                    </Border>
                </Popup>
                <ToggleButton x:Name="HighlightButton" Style="{StaticResource ToolToggle}" ToolTip="Highlight" AutomationProperties.Name="Highlight color">
                    <StackPanel>
                        <TextBlock Text="&#xE7E6;" FontFamily="{StaticResource IconFont}" HorizontalAlignment="Center" />
                        <Border x:Name="HighlightSwatch" Height="3" Width="16" Background="{StaticResource Highlight}" />
                    </StackPanel>
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=HighlightButton}" PlacementTarget="{Binding ElementName=HighlightButton}"
                       StaysOpen="False" Closed="Popup_Closed" Tag="{Binding ElementName=HighlightButton}">
                    <Border Style="{StaticResource Card}" Padding="10">
                        <StackPanel Width="188">
                            <TextBlock Text="Highlight" Style="{StaticResource Label}" />
                            <WrapPanel x:Name="HighlightSwatches" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="Apply" Padding="8,3" Click="CustomHighlight_Click" />
                                <TextBox x:Name="HighlightHex" Margin="0,0,6,0" Text="#FFF1B8" AutomationProperties.Name="Custom highlight color" />
                            </DockPanel>
                            <Button Content="No highlight" Margin="0,8,0,0" Click="NoHighlight_Click" />
                        </StackPanel>
                    </Border>
                </Popup>
                <Border Style="{StaticResource Sep}" />
                <ToggleButton x:Name="BoldButton" Style="{StaticResource ToolToggle}" ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold" Click="Bold_Click">
                    <TextBlock Text="B" FontWeight="Bold" />
                </ToggleButton>
                <ToggleButton x:Name="ItalicButton" Style="{StaticResource ToolToggle}" ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic" Click="Italic_Click">
                    <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" />
                </ToggleButton>
                <ToggleButton x:Name="UnderlineButton" Style="{StaticResource ToolToggle}" ToolTip="Underline (Ctrl+U)" AutomationProperties.Name="Underline" Click="Underline_Click">
                    <TextBlock Text="U" TextDecorations="Underline" />
                </ToggleButton>
                <ToggleButton x:Name="StrikeButton" Style="{StaticResource ToolToggle}" ToolTip="Strikethrough (Ctrl+Shift+X)" AutomationProperties.Name="Strikethrough" Click="Strike_Click">
                    <TextBlock Text="S" TextDecorations="Strikethrough" />
                </ToggleButton>
                <Border Style="{StaticResource Sep}" />
                <Button Style="{StaticResource ToolButton}" Content="H1" FontWeight="SemiBold" ToolTip="Heading 1" AutomationProperties.Name="Heading 1" Click="H1_Click" />
                <Button Style="{StaticResource ToolButton}" Content="H2" FontWeight="SemiBold" ToolTip="Heading 2" AutomationProperties.Name="Heading 2" Click="H2_Click" />
                <Button Style="{StaticResource ToolButton}" Content="¶" ToolTip="Normal text" AutomationProperties.Name="Normal text" Click="Normal_Click" />
                <Border Style="{StaticResource Sep}" />
                <ToggleButton x:Name="BulletButton" Style="{StaticResource ToolToggle}" ToolTip="Bulleted list" AutomationProperties.Name="Bulleted list" Click="Bullets_Click">
                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" />
                </ToggleButton>
                <ToggleButton x:Name="NumberButton" Style="{StaticResource ToolToggle}" ToolTip="Numbered list" AutomationProperties.Name="Numbered list" Click="Numbers_Click">
                    <TextBlock Text="1." FontWeight="SemiBold" />
                </ToggleButton>
                <ToggleButton x:Name="ChecklistButton" Style="{StaticResource ToolToggle}" ToolTip="Checklist (Ctrl+Shift+L). Ctrl+Enter ticks an item." AutomationProperties.Name="Checklist" Click="Checklist_Click">
                    <TextBlock Text="&#xE73A;" FontFamily="{StaticResource IconFont}" />
                </ToggleButton>
                <Border Style="{StaticResource Sep}" />
                <Button Style="{StaticResource ToolButton}" ToolTip="Insert image (or paste / drag one in)" AutomationProperties.Name="Insert image" Click="InsertImage_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                        <TextBlock Text="Image" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Attach a file (or drag one in)" AutomationProperties.Name="Attach file" Click="AttachFile_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE723;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                        <TextBlock Text="File" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <RichTextBox x:Name="Box" BorderThickness="0" Background="{StaticResource Surface}" Foreground="{StaticResource Ink}"
                     IsDocumentEnabled="True" AcceptsTab="True" AllowDrop="True" SpellCheck.IsEnabled="True"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Journal text" />
    </DockPanel>
</UserControl>
