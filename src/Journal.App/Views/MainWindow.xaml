<Window x:Class="Journal.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Journal.App.Controls"
        Title="Journal" Width="1240" Height="820" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Window.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LockCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding OpenSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Settings" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LockCommand}" ToolTip="Lock (Ctrl+L)" AutomationProperties.Name="Lock">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                            <TextBlock Text="Lock" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="Logo" Source="{StaticResource QuillLogo}" Width="30" Height="30" VerticalAlignment="Center"
                           AutomationProperties.Name="Journal logo" />
                    <TextBlock Text="Journal" FontFamily="{StaticResource DisplayFont}" FontSize="20" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LockText}" Foreground="{StaticResource InkMuted}" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource InkMuted}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: calendar and search -->
            <DockPanel Grid.Column="0">
                <c:MonthCalendarControl DockPanel.Dock="Top" DataContext="{Binding Calendar}" />
                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,8" DataContext="{Binding Search}">
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,28,7"
                                 AutomationProperties.Name="Search the journal" ToolTip="Words, &quot;a phrase&quot;, tag:name, in:captions, from:2026-01-01, is:open">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Escape" Command="{Binding ClearCommand}" />
                                <KeyBinding Key="Enter" Command="{Binding RunNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource InkMuted}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Search text, captions, files or tag:name" Foreground="{StaticResource InkFaint}" VerticalAlignment="Center"
                                   Margin="32,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QueryText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" HorizontalAlignment="Right"
                                Command="{Binding ClearCommand}" ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding TagSuggestions}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Padding="8,2" Margin="0,0,6,4" FontSize="12"
                                        Command="{Binding DataContext.ApplySuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Warning}" Style="{StaticResource ErrorText}" FontSize="12" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Label}" Margin="0,6,0,0" />
                </StackPanel>
                <ListBox DataContext="{Binding Search}" ItemsSource="{Binding Results}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Search results"
                         x:Name="ResultsList" MouseUp="ResultsList_MouseUp" KeyDown="ResultsList_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="10,8">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock Text="{Binding SourceGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="{StaticResource InkMuted}" Margin="4,0,0,0" />
                                        </StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding DateText, Mode=OneWay}" />
                                            <Run Text=" · " Foreground="{StaticResource InkFaint}" />
                                            <Run Text="{Binding TabTitle, Mode=OneWay}" Foreground="{StaticResource Accent}" />
                                        </TextBlock>
                                    </DockPanel>
                                    <TextBlock c:Highlighting.Hit="{Binding}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12.5"
                                               Foreground="{StaticResource InkMuted}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Right: the open day -->
            <DockPanel Grid.Column="2" DataContext="{Binding CurrentEntry}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete this day's entry"
                            AutomationProperties.Name="Delete entry" VerticalAlignment="Center"
                            Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <StackPanel>
                        <TextBlock Text="{Binding Heading}" FontFamily="{StaticResource DisplayFont}" FontSize="26" />
                        <TextBlock Text="Planned day" Style="{StaticResource Label}" Margin="0,2,0,0"
                                   Visibility="{Binding IsFuture, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding LoadError}" Style="{StaticResource ErrorText}" Margin="0,4,0,0"
                                   Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>

                <!-- Verse and quote: text is selectable; Copy buttons copy it with its citation.
                     Each text area is capped at about seven lines and scrolls, so long passages never
                     crowd out the editor (FR-INSP-15). -->
                <Border x:Name="InspirationCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,14"
                        Visibility="{Binding Inspiration.HasAny, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,-4,-8,0">
                            <Button Style="{StaticResource IconButton}" Content="&#xE8B1;"
                                    ToolTip="Show a different verse and quote for this day" AutomationProperties.Name="Shuffle verse and quote"
                                    Command="{Binding ShuffleCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                    ToolTip="Copy the verse and the quote" AutomationProperties.Name="Copy verse and quote"
                                    Command="{Binding Inspiration.CopyBothCommand}" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Visibility="{Binding Inspiration.HasVerse, Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Top" Text="VERSE" Style="{StaticResource Label}" />
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Command="{Binding Inspiration.CopyVerseCommand}"
                                            ToolTip="Copy the verse with its reference" AutomationProperties.Name="Copy verse">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                            <TextBlock Text="Copy" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Inspiration.VerseReference, Mode=OneWay}"
                                             Foreground="{StaticResource Accent}" FontSize="12.5" VerticalAlignment="Center"
                                             AutomationProperties.Name="Verse reference" />
                                </DockPanel>
                                <ScrollViewer x:Name="VerseScroller" MaxHeight="{StaticResource InspirationTextMaxHeight}"
                                              VerticalScrollBarVisibility="Auto" PreviewMouseWheel="InspirationScroller_PreviewMouseWheel">
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Inspiration.VerseText, Mode=OneWay}"
                                             FontFamily="{StaticResource DisplayFont}" FontSize="14.5" AutomationProperties.Name="Verse" />
                                </ScrollViewer>
                            </DockPanel>
                            <Border Grid.Column="1" Width="1" Background="{StaticResource Line}" Margin="18,0" />
                            <DockPanel Grid.Column="2" Visibility="{Binding Inspiration.HasQuote, Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Top" Text="PHILOSOPHY" Style="{StaticResource Label}" />
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Command="{Binding Inspiration.CopyQuoteCommand}"
                                            ToolTip="Copy the quote with its author and source" AutomationProperties.Name="Copy quote">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                            <TextBlock Text="Copy" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Inspiration.QuoteAuthor, Mode=OneWay}"
                                             Foreground="{StaticResource Accent}" FontSize="12.5" VerticalAlignment="Center"
                                             AutomationProperties.Name="Quote author" />
                                </DockPanel>
                                <ScrollViewer x:Name="QuoteScroller" MaxHeight="{StaticResource InspirationTextMaxHeight}"
                                              VerticalScrollBarVisibility="Auto" PreviewMouseWheel="InspirationScroller_PreviewMouseWheel">
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Inspiration.QuoteText, Mode=OneWay}"
                                             FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" FontSize="14.5" AutomationProperties.Name="Quote" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Tags -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Tags" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,5,10,0" />
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TagChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,0,5,0"
                                                       VerticalAlignment="Center" Foreground="{StaticResource InkMuted}" ToolTip="This tag has its own tab"
                                                       Visibility="{Binding IsTabTag, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource LinkButton}" Content="{Binding Name}" Command="{Binding SearchCommand}"
                                                    ToolTip="Find entries with this tag" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9" Padding="5,2" Margin="4,0,0,0"
                                                    Command="{Binding RemoveCommand}" ToolTip="Remove tag" AutomationProperties.Name="Remove tag"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource LinkButton}" Content="+ Add tag" Command="{Binding AddTagCommand}" Margin="2,4,0,6" />
                    </WrapPanel>
                </DockPanel>

                <!-- Tabs with the editor -->
                <Grid>
                    <TabControl x:Name="Tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Background="Transparent"
                                BorderThickness="0" Padding="0">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Background="Transparent" MouseLeftButtonDown="TabHeader_MouseDown"
                                            ToolTip="Double-click to rename">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="8" Padding="5,2" Margin="6,0,0,0"
                                            Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RemoveTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="{Binding}" ToolTip="Delete tab" AutomationProperties.Name="Delete tab" />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="0,8,8,8">
                                    <c:JournalEditor />
                                </Border>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,4" Margin="0,2,0,0"
                            Command="{Binding AddTabCommand}" ToolTip="Add a tab for a tag" AutomationProperties.Name="Add tab">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="Tab" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
