<Window x:Class="Journal.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Journal.App.ViewModels"
        Title="Set up your journal" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Window.Resources>
        <Style x:Key="StepPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>
    <Border Padding="32,28">
        <StackPanel>
            <Image x:Name="Logo" Source="{StaticResource QuillLogo}" Width="56" Height="56" HorizontalAlignment="Left"
                   Margin="0,0,0,10" AutomationProperties.Name="Journal logo" />
            <TextBlock Text="Welcome to your journal" FontFamily="{StaticResource DisplayFont}" FontSize="24" Margin="0,0,0,6" />

            <!-- Step 1: location and Windows Hello -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:SetupStep.Location}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource Muted}" Text="Everything you write, including images and files, is encrypted on this PC." />
                <TextBlock Text="WHERE TO KEEP IT" Style="{StaticResource Label}" Margin="0,20,0,6" />
                <TextBox Text="{Binding VaultFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Journal folder" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="This PC (default)" Command="{Binding UseDefaultCommand}" Margin="0,0,8,0" />
                    <Button Content="OneDrive (backed up)" Command="{Binding UseOneDriveCommand}" Margin="0,0,8,0"
                            Visibility="{Binding HasOneDrive, Converter={StaticResource BoolToVis}}"
                            ToolTip="The journal stays encrypted in OneDrive, so a copy survives if this PC is lost." />
                    <Button Content="Choose folder…" Command="{Binding BrowseCommand}" />
                </StackPanel>
                <TextBlock Text="UNLOCKING" Style="{StaticResource Label}" Margin="0,20,0,6" />
                <TextBlock Text="{Binding HelloMessage}" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,10,0,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Create my journal" Margin="0,22,0,0" Padding="16,9"
                        HorizontalAlignment="Left" Command="{Binding CreateCommand}" IsDefault="True" />
            </StackPanel>

            <!-- Creating -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:SetupStep.Creating}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,12"
                           Text="Creating your journal. Windows Hello will ask you to verify a few times while it sets up the key." />
                <ProgressBar IsIndeterminate="True" Height="4" />
            </StackPanel>

            <!-- Step 2: recovery code -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:SetupStep.ShowCode}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Save your recovery code" FontWeight="SemiBold" FontSize="16" Margin="0,10,0,6" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="If Windows Hello on this PC is ever lost (a new PC, a Windows reinstall), this code is the only way to open your journal. Print it or write it down and keep it somewhere safe, away from this PC. It is shown only once." />
                <Border Background="{StaticResource SurfaceAlt}" CornerRadius="6" Padding="16,14" Margin="0,16,0,0">
                    <TextBox Text="{Binding RecoveryCodeText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas" FontSize="22" HorizontalAlignment="Center" AutomationProperties.Name="Recovery code" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Copy" Command="{Binding CopyCodeCommand}" Margin="0,0,8,0" />
                    <Button Content="Save to file…" Command="{Binding SaveCodeCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding HelloMessage}" Style="{StaticResource Muted}" Margin="0,14,0,0" FontSize="12" />
                <Button Style="{StaticResource PrimaryButton}" Content="I've saved it" Margin="0,20,0,0" Padding="16,9"
                        HorizontalAlignment="Left" Command="{Binding ContinueToConfirmCommand}" />
            </StackPanel>

            <!-- Step 3: confirm -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:SetupStep.Confirm}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Check your recovery code" FontWeight="SemiBold" FontSize="16" Margin="0,10,0,6" />
                <TextBlock Style="{StaticResource Muted}" Text="Type the last group of five characters from your saved code." />
                <TextBox Text="{Binding ConfirmInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="18" Width="140"
                         HorizontalAlignment="Left" Margin="0,12,0,0" CharacterCasing="Upper" AutomationProperties.Name="Last group of recovery code" />
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="Open my journal" Padding="16,9" Command="{Binding FinishCommand}"
                            IsDefault="True" Margin="0,0,12,0" />
                    <Button Style="{StaticResource LinkButton}" Content="Show the code again" Command="{Binding BackToCodeCommand}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
