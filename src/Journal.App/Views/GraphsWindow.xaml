<Window x:Class="Journal.App.Views.GraphsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Journal.App.Controls"
        Title="Graphs" Width="760" Height="680" MinWidth="520" MinHeight="400" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}" ShowInTaskbar="False">
    <DockPanel>
        <!-- Range (FR-TRK-09) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" IsCancel="True" />
                <TextBlock Text="SHOW" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ItemsControl ItemsSource="{Binding Ranges}" AutomationProperties.Name="Range" Focusable="False" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding Label}" GroupName="range" Margin="0,0,16,0" VerticalAlignment="Center"
                                         Checked="Range_Checked" Loaded="Range_Loaded" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid>
            <TextBlock x:Name="EmptyText" Margin="24" TextWrapping="Wrap" Foreground="{StaticResource InkMuted}"
                       Text="No tracked values yet. Add them in Settings → Tracked values, then write ##name=value in your journal, or add a tab named after the value.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMeasures}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GraphList" ItemsSource="{Binding Graphs}" Margin="16,12,16,4" Focusable="False" AutomationProperties.Name="Graphs">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" AutomationProperties.Name="{Binding Name}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LatestText}" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Heading}" Style="{StaticResource Label}" Margin="0" />
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="12" />
                                        </StackPanel>
                                    </DockPanel>
                                    <c:LineChart ShowAxes="True" Height="190" Margin="0,8,0,0" Points="{Binding Points}"
                                                 PointCommand="{Binding DataContext.OpenDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 AutomationProperties.Name="{Binding AutomationName}" />
                                    <!-- The values as a table, so they can be read without the graph (FR-TRK-09). -->
                                    <Expander Header="Values" Margin="0,6,0,0" AutomationProperties.Name="{Binding Name, StringFormat={}{0} values}">
                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="190" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding PeriodText}" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="{Binding DateText}"
                                                                Command="{Binding DataContext.OpenDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="Open this day"
                                                                AutomationProperties.Name="{Binding DateText, StringFormat=Open {0}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
