<Window x:Class="Journal.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="640" Height="640" MinHeight="480" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Close" Margin="0,0,8,0" IsCancel="True" Click="Close_Click" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
        <TabControl Margin="16,12,16,0" BorderThickness="0" Background="Transparent">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="LOCK AUTOMATICALLY AFTER" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding AutoLockOptions}" SelectedItem="{Binding AutoLock}" DisplayMemberPath="Label"
                                      Width="180" HorizontalAlignment="Left" AutomationProperties.Name="Lock automatically after" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                                       Text="The journal also locks when you lock Windows (Win+L) or the PC goes to sleep." />

                            <TextBlock Text="WEEK STARTS ON" Style="{StaticResource Label}" Margin="0,18,0,6" />
                            <ComboBox ItemsSource="{Binding WeekStarts}" SelectedItem="{Binding WeekStart}" Width="180"
                                      HorizontalAlignment="Left" AutomationProperties.Name="Week starts on" />

                            <TextBlock Text="JOURNAL LOCATION" Style="{StaticResource Label}" Margin="0,18,0,6" />
                            <TextBox Text="{Binding VaultFolder, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Journal location" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Move…" Command="{Binding MoveVaultCommand}" Margin="0,0,8,0" />
                                <Button Content="Export backup…" Command="{Binding ExportBackupCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Security">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="RECOVERY CODE" Style="{StaticResource Label}" />
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Lost your recovery code? Create a new one while the journal is unlocked. The old code stops working." />
                            <Button Content="Create a new recovery code…" Command="{Binding RegenerateRecoveryCodeCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />

                            <TextBlock Text="WINDOWS HELLO" Style="{StaticResource Label}" Margin="0,22,0,6" />
                            <TextBlock Style="{StaticResource Muted}" Text="PCs that can unlock this journal with Windows Hello:" />
                            <ItemsControl ItemsSource="{Binding HelloMachines}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Remove"
                                                    Command="{Binding DataContext.RemoveMachineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Set up Windows Hello on this PC" Command="{Binding EnrollHelloCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Verse &amp; quote">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox Content="Show a Bible verse each day" IsChecked="{Binding ShowVerse}" FontWeight="SemiBold" />
                                <StackPanel Margin="22,8,0,0" IsEnabled="{Binding ShowVerse}">
                                    <RadioButton Content="World English Bible (built in)" IsChecked="{Binding UseImportedVerses, Converter={StaticResource Invert}}" GroupName="vs" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <RadioButton Content="My imported verses" IsChecked="{Binding UseImportedVerses}" GroupName="vs" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ImportedVersesText}" Foreground="{StaticResource InkMuted}" Margin="8,0,8,0" VerticalAlignment="Center" />
                                        <Button Content="Import…" Padding="8,2" Command="{Binding ImportVersesCommand}"
                                                ToolTip="CSV or JSON with reference, text, translation" />
                                    </StackPanel>
                                    <TextBlock Text="ONLY THESE BOOKS (none checked = all)" Style="{StaticResource Label}" Margin="0,12,0,4" />
                                    <ItemsControl ItemsSource="{Binding Books}" MaxHeight="150">
                                        <ItemsControl.Template>
                                            <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Width="140" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox Content="Show a philosophy quote each day" IsChecked="{Binding ShowQuote}" FontWeight="SemiBold" />
                                <StackPanel Margin="22,8,0,0" IsEnabled="{Binding ShowQuote}">
                                    <RadioButton Content="Classic philosophers (built in)" IsChecked="{Binding UseImportedQuotes, Converter={StaticResource Invert}}" GroupName="qs" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <RadioButton Content="My imported quotes" IsChecked="{Binding UseImportedQuotes}" GroupName="qs" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ImportedQuotesText}" Foreground="{StaticResource InkMuted}" Margin="8,0,8,0" VerticalAlignment="Center" />
                                        <Button Content="Import…" Padding="8,2" Command="{Binding ImportQuotesCommand}"
                                                ToolTip="CSV or JSON with text, author, work, tradition" />
                                    </StackPanel>
                                    <TextBlock Text="ONLY THESE TRADITIONS (none checked = all)" Style="{StaticResource Label}" Margin="0,12,0,4" />
                                    <ItemsControl ItemsSource="{Binding Traditions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Width="160" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="HOW EACH DAY'S VERSE AND QUOTE ARE CHOSEN" Style="{StaticResource Label}" />
                                <RadioButton Content="By day of the year (the same date gets the same ones every year)"
                                             IsChecked="{Binding RandomPerDay, Converter={StaticResource Invert}}" GroupName="mode" />
                                <RadioButton Content="Randomly for each day" IsChecked="{Binding RandomPerDay}" GroupName="mode" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                           Text="Days you've already written keep the verse and quote they had." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
