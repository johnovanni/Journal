<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Journal.App.Controls">

    <!-- Default templates for the blocks embedded in the editor. They live here (not in Theme.xaml)
         so they apply wherever the controls are created, including tests and XAML re-created by undo. -->

    <Style TargetType="{x:Type c:ImageBlockView}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ImageBlockView}">
                    <Border Background="#FFFFFF" BorderBrush="#DCDFE5" BorderThickness="1" CornerRadius="4" Padding="6">
                        <StackPanel>
                            <Grid MinHeight="60" Background="#F4F5F7">
                                <TextBlock Text="Image unavailable" Foreground="#646C7A" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="PART_Image" Stretch="Uniform" StretchDirection="DownOnly"
                                       HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"
                                       AutomationProperties.Name="{Binding Caption, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                            <TextBox x:Name="PART_Caption" Margin="0,6,0,0" BorderThickness="0,0,0,1" BorderBrush="#DCDFE5"
                                     Background="Transparent" FontStyle="Italic" FontSize="12.5" Foreground="#3A4150"
                                     TextWrapping="Wrap" AcceptsReturn="False"
                                     AutomationProperties.Name="Image caption"
                                     Text="{Binding Caption, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock IsHitTestVisible="False" Margin="2,-20,0,0" FontStyle="Italic" FontSize="12.5" Foreground="#9AA0AC"
                                       Text="Add a caption…">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Caption, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:AttachmentChip}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:AttachmentChip}">
                    <Border Background="#EEF0F3" BorderBrush="#DCDFE5" BorderThickness="1" CornerRadius="14" Padding="10,4,12,4"
                            ToolTip="Double-click to open. Right-click for more.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="#1F6F78" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{TemplateBinding FileName}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#1E2430" />
                            <TextBlock Text="{TemplateBinding SizeText}" Foreground="#646C7A" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="—" Foreground="#9AA0AC" Margin="8,0" VerticalAlignment="Center" />
                            <Grid VerticalAlignment="Center" MinWidth="120">
                                <TextBox x:Name="PART_Description" BorderThickness="0" Background="Transparent" Foreground="#3A4150"
                                         AutomationProperties.Name="File description" Cursor="IBeam"
                                         Text="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock IsHitTestVisible="False" Margin="2,0,0,0" Foreground="#9AA0AC" Text="add a description">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Description, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
